# ============================================================
# Tesco Structures — SPA fallback for Apache / Hostinger
# ============================================================
# Without this, refreshing on any route other than "/" returns
# a 404 because the server tries to find /about, /peb, etc. as
# real files. This rewrites every request that doesn't match a
# real file or folder to index.html, letting react-router-dom
# handle the route on the client.

<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # Don't rewrite existing files or folders (assets, brochure.pdf, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Everything else falls back to the SPA entry point
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# ============================================================
# Cache static assets aggressively (1 year)
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/gif                "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType application/pdf          "access plus 1 month"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# Gzip compress text-based assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
